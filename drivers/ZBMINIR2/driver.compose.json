    "learnmode": {
      "image": "/drivers/ZBMINIR2/assets/learn.svg",
      "instruction": {
        "en": "Press the button on the top for aprox. 10 seconds until the green LED blinks rapidly.",
        "da": "Tryk på knappen øverst i ca. 10 sekunder, indtil den grønne LED blinker hurtigt.",
        "de": "Drücken Sie den Knopf auf der Oberseite für ca. 10 Sekunden, bis die grüne LED schnell blinkt.",
        "es": "Presione el botón en la parte superior durante aprox. 10 segundos hasta que el LED verde parpadee rápidamente.",
        "fr": "Appuyez sur le bouton en haut pour plus d’informations. 10 secondes jusqu’à ce que la LED verte clignote rapidement.",
        "it": "Premere il pulsante in alto per ca. 10 secondi fino a quando il LED verde lampeggia rapidamente.",
        "ko": "위쪽에 있는 버튼을 눌러 약식을 확인합니다. 녹색 LED가 빠르게 깜박일 때까지 10초 동안 기다립니다.",
        "nl": "Druk op de knop aan de bovenkant voor ongeveer. 10 seconden totdat de groene LED snel knippert.",
        "no": "Trykk på knappen på toppen i ca. 10 sekunder til den grønne LED-lampen blinker raskt.",
        "pl": "Naciśnij przycisk na górze, aby uzyskać ok. 10 sekund, aż zielona dioda LED zacznie szybko migać.",
        "ru": "Нажмите кнопку вверху для приблизости. 10 секунд, пока зеленый светодиод не начнет быстро мигать.",
        "sv": "Tryck på knappen på ovansidan för ca. 10 sekunder tills den gröna lysdioden blinkar snabbt."
      }
    }
  },
