    "learnmode": {
      "image": "/drivers/ZBM5/assets/learn.svg",
      "instruction": {
        "en": "Press and hold any rocker for approx. 10 seconds until the LED blinks rapidly.",
        "sv": "Tryck och håll in valfri vippa i ca 10 sekunder tills LED-lampan blinkar snabbt.",
        "nl": "Houd een willekeurige wip ongeveer 10 seconden ingedrukt totdat de LED snel knippert.",
        "da": "Tryk og hold en vilkårlig vippe nede i ca. 10 sekunder, indtil LED'en blinker hurtigt.",
        "de": "Halten Sie eine beliebige Wippe ca. 10 Sekunden lang gedrückt, bis die LED schnell blinkt.",
        "es": "Mantenga pulsado cualquier balancín durante aproximadamente 10 segundos hasta que el LED parpadee rápidamente.",
        "fr": "Maintenez n'importe quelle bascule enfoncée pendant environ 10 secondes jusqu'à ce que la LED clignote rapidement.",
        "it": "Tenere premuto un bilanciere qualsiasi per circa 10 secondi fino a quando il LED lampeggia rapidamente.",
        "no": "Trykk og hold en vilkårlig vippe i ca. 10 sekunder til LED-en blinker raskt.",
        "pl": "Naciśnij i przytrzymaj dowolny klawisz przez około 10 sekund, aż dioda LED zacznie szybko migać.",
        "ru": "Нажмите и удерживайте любую клавишу около 10 секунд, пока светодиод не начнет быстро мигать.",
        "ko": "LED가 빠르게 깜박일 때까지 아무 로커나 약 10초 동안 누르고 있으세요."
      }
    }
